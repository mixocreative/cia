#!/bin/sh
# The RUNBOOK's gate (step 6): on every fixture, the two-run mean of the commit under test is within
# half a row of the median of the last five shipped means ON THE SAME FIXTURE AND MODEL, no row was
# missed by every run, no control was filed, no ledger PASS was filed without an artefact, and a run
# scored since 2026-09-24 says what it executed. Install: tools/install-hooks.sh.
python tools/score.py --gate || exit 1
# The gate above judges the newest commit that HAS rows; this refuses the newest commit that changed
# SKILL.md or references/ and has none (untested doctrine would otherwise ship).
python tools/untested.py || exit 1
python tools/check_key_lines.py || exit 1

# Every reference file carries a unique reading receipt. A file without one cannot be told apart
# from a file nobody opened, which is the confusion receipts exist to remove.
python tools/receipts.py --gate || exit 1

# The build standard's reference implementation must still satisfy the four properties it claims.
# A reference that rots into an aspiration is the S21 defect committed by this skill's own docs.
if [ -f tools/reference/prove_stock_reduction.php ]; then
  php tools/reference/prove_stock_reduction.php || exit 1
fi

# Taiwanese Chinese, not mainland. Reports with context and an allowlist; never rewrites,
# because a blanket 代碼 -> 程式碼 sweep once broke 超商代碼 in eight places.
python tools/zh_check.py --gate || exit 1

# Not a gate, a report: the comparison arms and EGM reviews that are due (RUNBOOK step 7). This is
# where the AI that pushes meets the trigger. It is not in SKILL.md, because every audit run reads
# SKILL.md and a sentence there is doctrine under test: the first try failed the gate (ARMS.md).
python tools/due.py || true

# Not a gate, a report: where the two skills' shared doctrine has drifted, and which shared file
# is currently a byte-identical duplicate (edit one, and the other is silently behind).
python tools/sweep-diff.py --files || true
